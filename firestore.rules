rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null || userId.matches('demo-.*') || userId == 'caretaker-demo-patient';
    }
    match /system/counters {
      allow read, write: if true;
    }
    // WebAuthn fingerprint data — server-only (Cloud Functions use Admin access)
    match /webauthnCredentials/{id} {
      allow read, write: if false;
    }
    match /webauthnChallenges/{id} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
